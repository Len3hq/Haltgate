# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real private keys.

# Wallet private key used by script/Deploy.s.sol -- must hold testnet OKB
# for gas. Get testnet OKB from web3.okx.com/xlayer/faucet.
DEPLOYER_PRIVATE_KEY=0x...

# Optional: real testnet USDG contract address on X Layer, once confirmed.
# If unset, Deploy.s.sol deploys MockUSDG instead (see BUILD.md §7).
USDG_ADDRESS=

# Optional: the fast-acting operational address that can call
# HaltController.beginHalting()/completeResume(). Defaults to the deployer
# if unset.
KEEPER_ADDRESS=

# Optional: real multisig co-signers, one per numbered var (up to 10),
# no trailing gaps. If none are set, the multisig has a single signer (the
# deployer) with threshold 1 -- fine to start, but not genuinely multi-party
# until real co-signers are added.
MULTISIG_SIGNER_1=
MULTISIG_SIGNER_2=
MULTISIG_SIGNER_3=

# Optional: how many of the signers above must agree. Defaults to 1.
MULTISIG_THRESHOLD=

# Optional: seconds the timelock must wait after the multisig schedules an
# operation before anyone can execute it. Defaults to 600 (10 min) -- fine
# for a live demo, but set to something on the order of days before anything
# resembling a real deployment.
TIMELOCK_MIN_DELAY=
