# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Deployer key -- needs testnet OKB for gas (web3.okx.com/xlayer/faucet).
DEPLOYER_PRIVATE_KEY=0x...

# Real testnet USDG on X Layer -- 6 decimals, not 18. Unset = deploy MockUSDG.
USDG_ADDRESS=0xF0863D7A29a55d0c4263c11bFac754312ff078DF

# Can call beginHalting()/completeResume(). Defaults to the deployer.
KEEPER_ADDRESS=

# Multisig co-signers, no trailing gaps. None set = 1-of-1 on the deployer.
MULTISIG_SIGNER_1=
MULTISIG_SIGNER_2=
MULTISIG_SIGNER_3=

# How many signers must agree. Defaults to 1.
MULTISIG_THRESHOLD=

# Timelock wait before a scheduled op can execute. Defaults to 600s -- use
# days for anything real.
TIMELOCK_MIN_DELAY=


# === LIVE DEPLOYMENT -- X Layer testnet, chain 1952 ========================
# Public addresses. The frontend reads its own copy from
# frontend/lib/contracts.ts; these let cast/forge scripts use the same ones.

# Five-state machine (OPEN/HALTING/HALTED/RESUMING/SETTLING) gating every
# risk-increasing action. Owned by timelock.
HALT_CONTROLLER_ADDRESS=0x4C4AC6fd104Eb8CE9887a0e7Da757f86d08EE807

# Risk engine: collateral, LTV, borrow, repay, liquidate, interest. Owned by timelock.
MARKET_ADDRESS=0x3ff6a0071655B1179C64f7114b175B141af91978

# ERC-4626 vault holding lender USDG, issuing hgUSDG. Owned by timelock.
LENDER_VAULT_ADDRESS=0x0051f29d5E2BFC85542266a3B9894Da2db2aDf4d

# Kinked utilization curve, per-second rates. Owned by timelock.
INTEREST_RATE_MODEL_ADDRESS=0x5F644BDF606cdb770c76bb01d6c3B83EA9F21845

# Oracle-priced wNVDAx<->USDG swap standing in for a DEX. 0.30% fee, halt-gated.
# Owned by multisig.
SWAP_MODULE_ADDRESS=0x3797E011686e756EFfb8619B5faDCE261BA59680

# Stateless leverage() / multiply(). Takes market as a parameter. No owner.
LEVERAGE_ZAP_ADDRESS=0xfCB4A5C042fE54e04A7F9027992f06F40F4F55be

# Mock feed replicating Backed's pauseOracle() -- this is the halt trigger.
# Owned by multisig.
ORACLE_ADDRESS=0x6092743d17D892c2C6033CF323783Bd7ec5952D4

# Mock wrapped-xStock collateral: non-rebasing, 18 decimals.
WNVDAX_ADDRESS=0xe37088E75e24AbE5DE1ac6d188803405D9DEbb42

# Permissionless collateral faucet, one claim per address.
WNVDAX_FAUCET_ADDRESS=0xBCFDa358dfdA7d8FFB53e2294846809c5DB8b57D

# Propose/confirm/execute. Owns oracle + SwapModule, sole timelock proposer.
# 1-of-1 on testnet -- not a real security boundary at that threshold.
MULTISIG_ADDRESS=0x46Af2FD4bF206321Bcd24A58F4497B2681C7716F

# OZ TimelockController. Owns Market, LenderVault, HaltController, IRM.
TIMELOCK_ADDRESS=0x6e4591c9A44C28f29F570B19ab82781BA136305F
